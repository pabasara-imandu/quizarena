# --- local development -------------------------------------------------------
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# --- production --------------------------------------------------------------
# CLIENT_ORIGIN is the origin the BROWSER is on, and it gates both CORS and
# Socket.IO. Behind a reverse proxy (docker compose) that is your public site;
# with split hosting it is the client host. Comma-separate several.
#   CLIENT_ORIGIN=https://quiz.example.com
#   CLIENT_ORIGIN=https://quiz.example.com,https://staging.example.com
# "*" allows any origin. Convenient for a quick demo, but it lets any website
# open sockets against your rooms - do not leave it on for a real class.
#   CLIENT_ORIGIN=*

# Optional: real AI question generation. Without it /api/generate returns an
# editable scaffold instead.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: only needed to run more than one server process. Also requires
# sticky sessions on the PIN at your load balancer.
# REDIS_URL=redis://localhost:6379

# Grace window (ms) added to each question deadline to absorb network latency
ANSWER_GRACE_MS=1200
# Rooms with no host + no players are garbage collected after this many ms
ROOM_TTL_MS=7200000
