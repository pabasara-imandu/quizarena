NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Optional Google sign-in for hosts. Same value as the server's GOOGLE_CLIENT_ID.
# Leave empty and the sign-in button simply does not appear.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Who may save translations from /admin (server-side only; never in the page).
# Comma-separated Google accounts. Leave empty to use admins.json at the repo root.
ADMIN_EMAILS=

# LOCAL DEVELOPMENT ONLY - lets /admin act as this email without a Google
# popup. Set the same address as ADMIN_DEV_BYPASS_EMAIL in server/.env.
# Never set either on a deployment.
# ADMIN_DEV_BYPASS_EMAIL=you@example.com
# NEXT_PUBLIC_ADMIN_DEV_EMAIL=you@example.com
